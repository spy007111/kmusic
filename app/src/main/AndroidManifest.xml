<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 音频效果链（Equalizer / BassBoost / Virtualizer / PresetReverb）必需。
         缺这条权限时 AudioEffect 构造直接抛异常，表现为「均衡器只有开关、拖了没反应」。
         这是普通权限，安装即授予，不需要运行时申请。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only requested by the explicit call-resume/device-binding actions. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 本地音乐库扫描 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 电视盒子 / TV 投屏盒：没有触摸屏也能装。
         不加这条时，Play 商店与部分盒子的安装器会把「需要触摸屏」当成硬门槛。
         手机 / 车机本来就有触摸屏，这条 required=false 对它们没有任何影响。
         ⚠️ 不要加 <uses-feature android:name="android.hardware.touchscreen" android:required="true"/>，
         那会把 TV 直接排除掉。 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- 遥控器方向键（D-pad）：声明为非必需，避免挡住只有触屏的手机 -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".MoyinApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.KMusic">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.KMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TV 桌面（leanback launcher）也要能看到这个 App。
                 这条只是**多一个入口**，不替换上面的 LAUNCHER，
                 所以手机 / 车机的桌面图标行为完全不变。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    
        <!-- 播放前台服务：MediaSession 让系统媒体卡片/锁屏/耳机按键能拿到歌曲信息，
             前台常驻保证后台播放不被系统掐掉 -->
        <service
            android:name=".playback.MoyinPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- 下载前台服务：让下载在 App 退到后台/被回收后继续（母带单曲上百 MB，断了很痛） -->
        <service
            android:name=".data.MoyinDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            导出诊断日志。exported=false + grantUriPermissions：
            只有我们主动发 Intent 时，接收方（微信/QQ/邮件）才临时拿到读权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
